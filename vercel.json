{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/traffic-ticket-case-management run build",
  "outputDirectory": "artifacts/traffic-ticket-case-management/dist/public",
  "functions": {
    "api/express.mjs": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/express" },
    { "source": "/__clerk/(.*)", "destination": "/api/express" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
