# ── Core ──────────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or a local mongod).
DATABASE_URL=mongodb://127.0.0.1:27017/docketline

# Clerk (leave CLERK_PUBLISHABLE_KEY unset to fall back to the built-in key).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# 1 = local demo auth bypass (no Clerk account needed). Never enable in production.
DEMO_MODE=

# Public origin of the SPA. Needed when the browser origin is not forwarded to
# the API (Vite proxy, custom domain). Also used as the base for the OAuth
# redirect_uri below.
APP_BASE_URL=https://your-app.example.com

# ── Google Calendar (two-way sync) ────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI — must match exactly, per environment:
#   https://your-app.example.com/api/integrations/google/callback
#   http://localhost:5000/api/integrations/google/callback   (local)
# While the OAuth consent screen is in "Testing", only accounts listed under
# Audience → Test users can grant access; everyone else sees "Access blocked".
#
# Optional: force the exact redirect URI. Leave unset to use
# ${APP_BASE_URL}/api/integrations/google/callback. Set it to the bare origin
# (e.g. http://localhost:5000) when the OAuth client only registers that — the
# SPA's inline relay then forwards ?code&state to the API callback.
# GOOGLE_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32+ random characters. Encrypts the stored Google refresh/access tokens with
# AES-256-GCM. Falls back to GOOGLE_CLIENT_SECRET when unset — set it explicitly
# in production so rotating the client secret does not invalidate connections.
TOKEN_ENCRYPTION_KEY=

# HMAC key for the signed OAuth state parameter (15-minute TTL).
# Falls back to CLERK_SECRET_KEY.
GOOGLE_STATE_SECRET=

# IANA zone used for all-day court rows and timed event mapping.
CALENDAR_TIMEZONE=America/Toronto

# ── Email (optional) ──────────────────────────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
